// 数值由每日历表整理，同一套节气日期在不同年份复用。
interface CalendarYear {
  januaryLunarMonth: number;
  januaryLunarDay: number;
  leapMonthIndex: number;
  longMonths: number;
  termPattern: number;
}

function year(januaryLunarMonth: number, januaryLunarDay: number, leapMonthIndex: number,
  longMonths: number, termPattern: number): CalendarYear {
  return { januaryLunarMonth, januaryLunarDay, leapMonthIndex, longMonths, termPattern };
}

