// 键为 月 × 100 + 日。同日有多种标注时，优先显示节日，其次节气，最后农历日期。
const GREGORIAN_FESTIVALS: Map<number, string> = new Map<number, string>([
  [101, '元旦'], [308, '妇女节'], [501, '劳动节'], [601, '儿童节'], [910, '教师节'], [1001, '国庆节']
]);
const LUNAR_FESTIVALS: Map<number, string> = new Map<number, string>([
  [101, '春节'], [115, '元宵节'], [505, '端午节'], [707, '七夕'], [715, '中元节'],
  [815, '中秋节'], [909, '重阳节'], [1208, '腊八节']
]);

export function calendarAnnotation(stamp: number): string {
  const date = new Date(stamp);
  const civilYear = date.getFullYear();
  const monthIndex = date.getMonth();
  const day = date.getDate();
  const fixedHoliday = GREGORIAN_FESTIVALS.get((monthIndex + 1) * 100 + day);
  if (fixedHoliday) return fixedHoliday;
  const row = YEARS[civilYear - FIRST_YEAR];
  if (!row) return '';

  // 在本地读取格子的年月日，在 UTC 计算公历日序，夏令时不会导致错开一天。
  let remaining = (Date.UTC(civilYear, monthIndex, day) - Date.UTC(civilYear, 0, 1)) / 86400000 +
    row.januaryLunarDay - 1;
  let month = row.januaryLunarMonth;
  let index = 0;
  let length = 29 + ((row.longMonths >> index) & 1);
  while (remaining >= length) {
    remaining -= length;
    index++;
    if (index !== row.leapMonthIndex) month = month % 12 + 1;
    length = 29 + ((row.longMonths >> index) & 1);
  }
  if (month === 12 && remaining + 1 === length && index + 1 !== row.leapMonthIndex) return '除夕';
  const inLeapMonth = index === row.leapMonthIndex;
  if (!inLeapMonth) {
    const festival = LUNAR_FESTIVALS.get(month * 100 + remaining + 1);
    if (festival) return festival;
  }
  const terms = TERM_DAYS[row.termPattern];
  const firstTerm = monthIndex * 2;
  if (day === terms[firstTerm]) return TERMS[firstTerm];
  if (day === terms[firstTerm + 1]) return TERMS[firstTerm + 1];
  if (remaining === 0) return (inLeapMonth ? '闰' : '') + LUNAR_MONTHS[month - 1];
  return LUNAR_DAYS[remaining];
}
